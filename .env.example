# Invoice Service — environment example
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=production
PORT=3100
PUBLIC_BASE_URL=https://invoice.example.com

# PostgreSQL
DATABASE_URL=postgres://invoice:CHANGE_ME@127.0.0.1:5432/invoice

# Admin bootstrap (used by seed if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=HQ Admin

# Session
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Optional: Cloudflare Turnstile (login)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: SMTP for email OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: Cloudflare API (dashboard live DNS)
CF_API_TOKEN=
CF_ZONE_ID=

# Webhook HMAC clock skew (seconds)
WEBHOOK_MAX_SKEW_SECONDS=300

# PDF storage (absolute or relative to cwd)
PDF_STORAGE_DIR=./storage/pdfs

# Invoice number prefix assumptions — see README
INVOICE_TZ=Asia/Seoul
